{
  "manifest_version": 3,
  "name": "BunkerPass",
  "description": "Gerenciador de senhas com cofre cifrado e sincronização pelo Google Drive.",
  "version": "0.1.0",
  "action": {
    "default_title": "BunkerPass",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content-ui.js",
        "src/content-save.js",
        "src/content.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "unlimitedStorage",
    "idle",
    "offscreen",
    "clipboardWrite"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://api.pwnedpasswords.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir BunkerPass"
    }
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4",
      "strict_max_version": "*"
    }
  }
}
